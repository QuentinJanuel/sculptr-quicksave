  "keywords": [
    "fangame",
    "gamemaker",
    "i-wanna",
    "mod",
    "sculptr"
  ],
  "homepage": "https://github.com/QuentinJanuel/sculptr-quicksave#readme",
  "bugs": "https://github.com/QuentinJanuel/sculptr-quicksave/issues",
